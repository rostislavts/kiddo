# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Project Settings > Database / Connect > Transaction pooler (port 6543).
# URL-encode special characters in the database password.
DATABASE_URL=
# Optional direct/session connection for migrations (port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=5
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; required for parent account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle Billing SANDBOX credentials, never Paddle Classic.
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_MONTHLY_PRICE_ID=

# Learning policy, configurable after content review.
MASTERY_THRESHOLD=80
COMPLETION_THRESHOLD=60

# AI Lab: server-only provider credentials. Never use a NEXT_PUBLIC_ AI key.
AI_PROVIDER=openai
AI_API_KEY=

AI_TEXT_MODEL=gpt-5.4-mini

AI_IMAGE_MODEL=gpt-image-2

AI_LAB_ENABLED=true

CRON_SECRET=
